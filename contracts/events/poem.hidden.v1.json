{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://puisiapp.example/schema/poem.hidden.v1.json",
    "title":  "Event puisi disembunyikan",
    "description":  "Diterbitkan ketika puisi disembunyikan berdasarkan keputusan moderasi.",
    "type":  "object",
    "required":  [
                     "reason",
                     "hidden_at"
                 ],
    "properties":  {
                       "hidden_at":  {
                                         "type":  "string",
                                         "format":  "date-time"
                                     },
                       "reason":  {
                                      "minLength":  1,
                                      "type":  "string"
                                  }
                   },
    "additionalProperties":  false,
    "examples":  [
                     {
                         "reason":  "sample-value",
                         "hidden_at":  "2026-11-19T08:30:00Z"
                     }
                 ]
}
