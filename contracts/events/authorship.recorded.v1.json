{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puisiapp.example/schema/authorship.recorded.v1.json",
  "title": "Event catatan keaslian direkam",
  "description": "Catatan jejak keaslian versi puisi berhasil direkam.",
  "type": "object",
  "required": [
    "poem_id",
    "version",
    "content_hash",
    "algorithm"
  ],
  "properties": {
    "algorithm": {
      "const": "SHA-256",
      "type": "string"
    },
    "poem_id": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "poem_id": "0b7d6f0e-4a8b-4a52-9d0b-3f4f0e9b2a10",
      "version": 1,
      "content_hash": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
      "algorithm": "SHA-256"
    }
  ]
}
