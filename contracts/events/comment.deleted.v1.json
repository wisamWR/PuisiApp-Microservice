
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puisiapp.example/schema/comment.deleted.v1.json",
  "title": "Event komentar dihapus",
  "description": "Diterbitkan ketika komentar berhasil dihapus oleh pemiliknya atau moderator.",
  "type": "object",
  "required": [
    "comment_id",
    "poem_id",
    "user_id",
    "deleted_at"
  ],
  "properties": {
    "comment_id": {
      "type": "string",
      "format": "uuid"
    },
    "poem_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
