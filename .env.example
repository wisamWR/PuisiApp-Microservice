# Salin menjadi .env di root repositori:   cp .env.example .env
# Semua nilai di bawah HANYA untuk laptop pengembang dan bukan rahasia.
# Lingkungan EC2 memakai .env.production yang disimpan di luar repositori.
# Setiap layanan membaca alamat dependensi dari variabel di sini, bukan dari
# nama container yang ditulis langsung di kode.

# ---------------------------------------------------------------- Docker Compose
# Membuat `docker compose up -d` di root repositori memakai compose induk +
# override lokal. Pemisah ":" dipaksa supaya sama di Windows, Linux, dan macOS.
# Wajib huruf kecil (aturan Docker Compose).
COMPOSE_PROJECT_NAME=puisiapp
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=infra/docker-compose.yml:infra/docker-compose.dev.yml

# ---------------------------------------------------------------- RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=puisiApp
RABBITMQ_PASS=puisiApp_dev_only
RABBITMQ_VHOST=puisiApp

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Superuser: hanya dipakai skrip init dan relay, tidak oleh layanan.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only

# Password user database per layanan, dibaca skrip infra/postgres/init/NN-<layanan>.sql.
# Tambahkan baris baru di sini setiap kali menambah skrip init.
EXAMPLE_DB_PASS=example_dev_only
# User replikasi untuk outbox-relay (Debezium).
DEBEZIUM_DB_PASS=debezium_dev_only

# ---------------------------------------------------------------- MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=mongo_dev_only

# ---------------------------------------------------------------- Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_only

# ---------------------------------------------------------------- S3 (MinIO lokal)
# Kode layanan memakai AWS SDK yang sama untuk MinIO dan Amazon S3. Bedanya
# hanya di variabel ini. Di EC2 (.env.production):
#   S3_ENDPOINT=            (kosong -> endpoint AWS bawaan)
#   S3_FORCE_PATH_STYLE=false
#   S3_ACCESS_KEY= / S3_SECRET_KEY=   (kosong -> kredensial dari IAM LabRole)
#   S3_PUBLIC_BASE_URL=https://<domain-cloudfront>
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET=puisi-images
S3_ACCESS_KEY=minio_dev
# Minimal 8 karakter (syarat MinIO).
S3_SECRET_KEY=minio_dev_only
# Awalan URL gambar yang dibuka browser.
S3_PUBLIC_BASE_URL=http://localhost:9000/puisi-images

# ---------------------------------------------------------------- SMTP (Mailpit lokal)
SMTP_HOST=mailpit
SMTP_PORT=1025

# ---------------------------------------------------------------- Port host (opsional)
# Ubah bila bentrok dengan layanan yang sudah terpasang di laptop.
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_UI_HOST_PORT=15672
# POSTGRES_HOST_PORT=5432
# MONGO_HOST_PORT=27017
# REDIS_HOST_PORT=6379
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025
