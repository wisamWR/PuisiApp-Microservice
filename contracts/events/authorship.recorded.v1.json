{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://puisiapp.example/schema/authorship.recorded.v1.json",
    "title":  "Event catatan keaslian direkam",
    "description":  "Catatan jejak keaslian versi puisi berhasil direkam.",
    "type":  "object",
    "required":  [
                     "poem_id",
                     "version",
                     "content_hash",
                     "algorithm"
                 ],
    "properties":  {
                       "algorithm":  {
                                         "const":  "SHA-256",
                                         "type":  "string"
                                     },
                       "poem_id":  {
                                       "minLength":  1,
                                       "type":  "string"
                                   },
                       "version":  {
                                       "type":  "integer",
                                       "minimum":  1
                                   },
                       "content_hash":  {
                                            "type":  "string",
                                            "pattern":  "^[a-fA-F0-9]{64}$"
                                        }
                   },
    "additionalProperties":  false,
    "examples":  [
                     {
                         "poem_id":  "sample-value",
                         "version":  1,
                         "content_hash":  "sample-value",
                         "algorithm":  "SHA-256"
                     }
                 ]
}
