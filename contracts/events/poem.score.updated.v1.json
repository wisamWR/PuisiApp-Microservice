{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puisiapp.example/schema/events/poem.score.updated.v1.json",
  "title": "Poem Score Updated Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["poem_id", "score", "vote_count", "updated_at"],
  "properties": {
    "poem_id": { "type": "string", "minLength": 1 },
    "score": { "type": "integer" },
    "vote_count": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
