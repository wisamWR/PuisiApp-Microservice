{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puisiapp.example/schema/events/case.decided.v1.json",
  "title": "Moderation Case Decided Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "poem_id", "moderator_id", "decision", "reason", "decided_at"],
  "properties": {
    "case_id": { "type": "string", "format": "uuid" },
    "poem_id": { "type": "string", "minLength": 1 },
    "moderator_id": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "string",
      "enum": ["APPROVE", "REJECT", "HIDE", "DELETE", "RESTORE"]
    },
    "reason": { "type": "string", "minLength": 1 },
    "decided_at": { "type": "string", "format": "date-time" }
  }
}
