{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puisiapp.example/schema/authorship.recorded.v1.json",
  "title": "Event catatan keaslian direkam",
  "description": "Catatan timestamp dan rantai hash setiap versi puisi.",
  "type": "object",
  "required": [
    "poem_id",
    "version",
    "content_hash",
    "previous_hash",
    "chain_hash",
    "recorded_at",
    "algorithm"
  ],
  "properties": {
    "poem_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "chain_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "algorithm": {
      "type": "string",
      "const": "SHA-256"
    }
  },
  "additionalProperties": false
}
