{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://puisiapp.example/schema/poem.themes.extracted.v1.json",
    "title":  "Event tema puisi diekstraksi",
    "description":  "Hasil ekstraksi tema dari puisi.",
    "type":  "object",
    "required":  [
                     "poem_id",
                     "themes"
                 ],
    "properties":  {
                       "poem_id":  {
                                       "minLength":  1,
                                       "type":  "string"
                                   },
                       "themes":  {
                                      "minItems":  1,
                                      "items":  {
                                                    "type":  "string",
                                                    "enum":  [
                                                                 "rindu",
                                                                 "kesepian",
                                                                 "alam",
                                                                 "perjuangan",
                                                                 "keluarga",
                                                                 "religius",
                                                                 "lainnya"
                                                             ]
                                                },
                                      "type":  "array"
                                  }
                   },
    "additionalProperties":  false
}
