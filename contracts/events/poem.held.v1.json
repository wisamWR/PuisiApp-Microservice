{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://puisiapp.example/schema/poem.held.v1.json",
    "title":  "Event puisi ditahan",
    "description":  "Diterbitkan ketika puisi ditahan karena dugaan jiplakan.",
    "type":  "object",
    "required":  [
                     "similarity_level",
                     "reason"
                 ],
    "properties":  {
                       "similarity_level":  {
                                                "type":  "string",
                                                "enum":  [
                                                             "suspected_plagiarism"
                                                         ]
                                            },
                       "reason":  {
                                      "minLength":  1,
                                      "type":  "string"
                                  }
                   },
    "additionalProperties":  false
}
