{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://puisiapp.example/schema/user.profile.updated.v1.json",
    "title":  "Event profil pengguna diperbarui",
    "description":  "Diterbitkan ketika profil pengguna berhasil diperbarui.",
    "type":  "object",
    "required":  [
                     "display_name",
                     "bio"
                 ],
    "properties":  {
                       "display_name":  {
                                            "maxLength":  100,
                                            "minLength":  1,
                                            "type":  "string"
                                        },
                       "bio":  {
                                   "maxLength":  500,
                                   "type":  "string"
                               }
                   },
    "additionalProperties":  false
}
