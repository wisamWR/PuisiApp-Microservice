{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puisiapp.example/schema/events/case.opened.v1.json",
  "title": "Moderation Case Opened Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "report_id", "poem_id", "status", "opened_at"],
  "properties": {
    "case_id": { "type": "string", "format": "uuid" },
    "report_id": { "type": "string", "format": "uuid" },
    "poem_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "const": "OPEN" },
    "opened_at": { "type": "string", "format": "date-time" }
  }
}
