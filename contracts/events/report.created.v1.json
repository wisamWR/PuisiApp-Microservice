{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puisiapp.example/schema/events/report.created.v1.json",
  "title": "Report Created Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "poem_id", "reporter_id", "reason", "created_at"],
  "properties": {
    "report_id": { "type": "string", "format": "uuid" },
    "poem_id": { "type": "string", "minLength": 1 },
    "reporter_id": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
