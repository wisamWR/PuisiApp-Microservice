# Paksa akhir baris LF di repositori. Skrip yang dijalankan di dalam container
# Linux (sh, sql init, entrypoint) rusak bila ter-checkout dengan CRLF di Windows.
* text=auto eol=lf

*.sh       text eol=lf
*.sql      text eol=lf
Dockerfile text eol=lf
*.bat      text eol=crlf
*.ps1      text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.otf binary
*.woff2 binary
*.ez binary
