{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://puisiapp.example/schema/poem.processing.completed.v1.json",
    "title":  "Event pemrosesan puisi selesai",
    "description":  "Seluruh tahapan pemrosesan puisi selesai.",
    "type":  "object",
    "required":  [
                     "poem_id",
                     "completed_at",
                     "status"
                 ],
    "properties":  {
                       "completed_at":  {
                                            "type":  "string",
                                            "format":  "date-time"
                                        },
                       "poem_id":  {
                                       "minLength":  1,
                                       "type":  "string"
                                   },
                       "status":  {
                                      "const":  "COMPLETED",
                                      "type":  "string"
                                  }
                   },
    "additionalProperties":  false
}
