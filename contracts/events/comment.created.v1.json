
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puisiapp.example/schema/comment.created.v1.json",
  "title": "Event komentar dibuat",
  "description": "Diterbitkan ketika pengguna berhasil membuat komentar pada puisi yang dipublikasikan.",
  "type": "object",
  "required": [
    "comment_id",
    "poem_id",
    "user_id",
    "content",
    "created_at"
  ],
  "properties": {
    "comment_id": {
      "type": "string",
      "format": "uuid"
    },
    "poem_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
