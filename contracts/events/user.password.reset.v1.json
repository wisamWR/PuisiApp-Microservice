{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puisiapp.example/schema/user.password.reset.v1.json",
  "title": "Payload event user.password.reset v1",
  "type": "object",
  "required": [
    "id",
    "password_hash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "ID pengguna yang kata sandinya direset"
    },
    "password_hash": {
      "type": "string",
      "description": "Hash Argon2id kata sandi baru"
    }
  },
  "additionalProperties": true
}
